# Cloudflare Pages cache + CORS rules for the SansadLocal data mirror.
# Read by CF Workers + Static Assets on each deploy; ignored by GitHub Pages.
#
# IMPORTANT: only ONE block sets Access-Control-Allow-Origin. CF Workers
# + Static Assets merges matching header rules across blocks — if both
# `/*.json` and `/*` set CORS, the response gets two `Access-Control-
# Allow-Origin: *` values, which browsers reject as malformed CORS.

# Public CORS for everything served from this mirror. Set once at the
# catch-all level so it doesn't duplicate when path-specific blocks
# below also match.
/*
  Access-Control-Allow-Origin: *

# JSON metadata changes on every backfill run (a few times a day during
# backfill, once daily steady-state). Short edge cache + revalidation
# means users see fresh data within ~5 minutes of a mirror push.
/*.json
  Cache-Control: public, max-age=300, must-revalidate

# Extracted text files are immutable in practice — once a report's text
# is published, the content doesn't change. Aggressive long-cache + the
# 'immutable' hint tells browsers and CF's edge to skip revalidation.
# If we ever need to invalidate (e.g. re-extraction with better OCR),
# add a query-string version to the fetch URL.
#
# v1.0a phase 2: paths moved under /<corpus>/text/. v1.0b adds CAG.
# Per-corpus rules (rather than a single /*/text/*) make any future
# per-corpus override straightforward.
/drsc/text/*
  Cache-Control: public, max-age=31536000, immutable
/cag/text/*
  Cache-Control: public, max-age=31536000, immutable
